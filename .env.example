# ============================================================
# PORTAL DR. VARIATO — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git!
# ============================================================

# Supabase — get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # server-side only!
SUPABASE_PROJECT_ID=your-project-id

# Resend (email OTP) — get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Portal Dr. Variato da Costa"

# Optional: for PDF generation
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
